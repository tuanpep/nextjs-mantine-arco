# Replace the example URLs, realm, and client ID with your own configuration.
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.example.com
NEXT_PUBLIC_KEYCLOAK_REALM=your-realm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=your-client-id
NEXT_PUBLIC_API_PREFIX=https://api.example.com/api
NEXT_PUBLIC_STOMP_URL=wss://api.example.com/api/socket
NEXT_PUBLIC_PROFILE_URI=/kernel/v1/users/current
NEXT_PUBLIC_PERMISSION_URI=/kernel/authz
NEXT_PUBLIC_DISPLAY_CACHE_TIME=300000
# Playwright only — ignored when NODE_ENV=production
# NEXT_PUBLIC_E2E_AUTH_BYPASS=1

# Your Keycloak client must allow these Valid Redirect URIs per environment:
#   http://localhost:4202/*
#   http://localhost:4202/silent-check-sso.html
#   https://app.example.com/*
#   https://app.example.com/silent-check-sso.html
# Web Origins should include the app origin (or +).
